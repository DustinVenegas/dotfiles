{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{.Folder}}{{if .Root}} :: root{{end}} :: {{.Shell}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " λ ",
          "foreground": "#FAFAFA",
          "background": "#4F90DB",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "enabled": "true"
          },
          "template": " # ",
          "foreground": "#060606",
          "background": "#DB9165",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "foreground": "#FAFAFA",
          "background": "#213C5C",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "style": "folder"
          },
          "template": " {{ .Path }} ",
          "foreground": "#FAFAFA",
          "background": "#4F90DB",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true
          },
          "template": "{{ .BranchStatus }}{{ if .Working.Changed }} W {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} S {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} ST {{ .StashCount }}{{ end }} ",
          "foreground": "#FAFAFA",
          "background": "#596675",
          "type": "git",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ .FormattedMs }} ",
          "foreground": "#060606",
          "background": "#DBC239",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " RET {{ .Code }} ",
          "foreground": "#060606",
          "background": "#DB65BA",
          "type": "exit",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "AWS:{{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "foreground": "#FFA400",
          "background": "#232F38",
          "type": "aws",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "AZ:{{ .EnvironmentName }}",
          "foreground": "#FFFFFF",
          "background": "#0078D4",
          "type": "az",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04:05"
          },
          "template": " {{ .CurrentDate | date .Format }} ",
          "foreground": "#6997C9",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " ",
          "foreground": "#0077c2",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "mapped_shell_names": {
              "pwsh": "ps"
            }
          },
          "template": "{{ .Name }}>",
          "foreground": "#FAFAFA",
          "type": "shell",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
